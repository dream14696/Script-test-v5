						if ActionMenu.Visible then
							playClickFeedback()
							ActionMenu.Visible = false
							trazo.Color = Color3.fromRGB(30, 40, 50)
						else
							playClickFeedback()
							estado = not estado
							if optionData.OnTrigger then
								optionData.OnTrigger(estado)
							end
						end
					end
				end
			else
				playClickFeedback()
				estado = not estado
				if optionData.OnTrigger then
					optionData.OnTrigger(estado)
				end
			end
			touchStartPos = nil
		end
	end)

	EditOptBtn.MouseButton1Click:Connect(function()
		playClickFeedback()
		ActionMenu.Visible = false
		trazo.Color = Color3.fromRGB(30, 40, 50)
		editingOption = optionData
		OptInput.Text = optionData.Name
		CodeInput.Text = optionData.Code
		optType = optionData.TypeId
		valueEnabled = optionData.ValueEnabled
		ValueInput.Text = tostring(optionData.ValueDefault)
		actualizarTypeUI()
		actualizarValueUI()
		mostrarModal(OptModal)
	end)
end

