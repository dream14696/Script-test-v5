					if typeId == 2 then
						triggerAction(true)
					else
						triggerAction(not estado)
					end
				end
				touchStartPos = nil
			end
		end
	end)

	if optionData.ValueEnabled then
		createValueBox(parentScroll, optionData)
	end

	Player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if activeOptionsRegistry[optionData] then
			ejecutarCodigoConsola(optionData.Code, true, optionData.ValueDefault)
		end
	end)
end

