--------------------------------------------------
-- ARRASTRO
--------------------------------------------------

local dragging
local dragStart
local startPos

Top.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		o input.UserInputType == Enum.UserInputType.MouseButton1 then
		arrastrando = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if arrastra and (
		input.UserInputType == Enum.UserInputType.Touch
		o input.UserInputType == Enum.UserInputType.MouseMovement
	) then
		local delta = input.Position - dragStart
		local vs = workspace.CurrentCamera.ViewportSize
		local hw = Main.AbsoluteSize.X / 2
		local curX = startPos.X.Offset
		local curY = startPos.Y.Offset

		local newX = math.clamp(curX + delta.X, hw, vs.X - hw)
		local nuevoY = math.clamp(curY + delta.Y, 0, vs.Y - 50)

		Main.Position = UDim2.new(0, nuevoX, 0, nuevoY)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		o input.UserInputType == Enum.UserInputType.MouseButton1 then
		arrastrando = false
	end
end)

